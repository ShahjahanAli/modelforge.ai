# ModelForge — public repository ignore rules
# Keep secrets, model weights, and local build artifacts out of git.

# ----- dependencies -----
node_modules/
.pnp
.pnp.js
.pnpm-store/

# ----- environment / secrets -----
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
*.pem
*.key
credentials.json
**/secrets/

# ----- model weights & fetched binaries -----
# GGUFs are large and often redistributed under their own licenses.
*.gguf
*.ggml
data/models/*
!data/models/.gitkeep
# Converted Faster-Whisper CTranslate2 weights (from HF Whisper fine-tunes)
data/voice/ct2/*
!data/voice/ct2/.gitkeep
# Local Ed25519 signing material for usage receipts
data/signing/
# Prebuilt llama.cpp binaries from `pnpm llama:fetch`
vendor/

# ----- build outputs -----
dist/
build/
out/
.next/
.turbo/
target/
*.tsbuildinfo
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- tooling / IDE -----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ----- databases / local runtime -----
*.db
*.db-journal
prisma/*.db
.vercel/

# ----- OS / misc -----
ehthumbs.db
Desktop.ini
