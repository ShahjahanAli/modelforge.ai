{
  "name": "@modelforge/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "e2e:llama": "tsx src/scripts/e2e-llama.ts",
    "registry:status": "tsx src/scripts/registry-status.ts",
    "worker": "tsx src/workers/usage-worker.ts",
    "invoice-worker": "tsx src/workers/invoice-worker.ts",
    "modern-worker": "tsx src/workers/modern-worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.7.15",
    "@modelforge/billing": "workspace:*",
    "@modelforge/db": "workspace:*",
    "@modelforge/engine": "workspace:*",
    "@modelforge/platform": "workspace:*",
    "bullmq": "^5.53.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "openai": "^7.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
