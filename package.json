{
  "name": "modelforge",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted LLM + ASR runtime platform. Provider for client apps (e.g. Anusandhan): chat, voice, Neo4j, MinIO.",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "ports:free": "dotenv -e .env -- node scripts/free-ports.mjs",
    "dev": "dotenv -e .env -- node scripts/free-ports.mjs && dotenv -e .env -- turbo run dev --parallel",
    "build": "dotenv -e .env -- turbo run build",
    "lint": "dotenv -e .env -- turbo run lint",
    "typecheck": "dotenv -e .env -- turbo run typecheck",
    "test": "dotenv -e .env -- turbo run test",
    "db:generate": "dotenv -e .env -- pnpm --filter @modelforge/db generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @modelforge/db migrate",
    "db:deploy": "dotenv -e .env -- pnpm --filter @modelforge/db migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @modelforge/db seed",
    "db:studio": "dotenv -e .env -- pnpm --filter @modelforge/db studio",
    "llama:fetch": "node scripts/fetch-llama-server.mjs",
    "engine:status": "dotenv -e .env -- node scripts/engine-status.mjs",
    "weights:scan": "dotenv -e .env -- node scripts/scan-weights.mjs",
    "test:e2e": "dotenv -e .env -- node scripts/e2e-openai.mjs",
    "test:inspector": "dotenv -e .env -- node scripts/e2e-core-inspector.mjs",
    "benchmark": "dotenv -e .env -- node scripts/benchmark-openai.mjs",
    "services:print": "dotenv -e .env -- node scripts/print-shared-services.mjs",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "protobufjs",
      "sharp"
    ]
  }
}
