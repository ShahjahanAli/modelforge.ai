# Shared PostgreSQL / Redis
DATABASE_URL=postgresql://modelforge:modelforge@localhost:5432/modelforge
# Set false for local Postgres-only setups (no Redis/Docker Redis needed)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Gateway + web (9000-series avoids Next/Express/Laravel defaults)
GATEWAY_PORT=9000
WEB_PORT=9001
INFERENCE_ENGINE_GRPC_URL=localhost:9002
# Must exceed max_tokens / throughput or long answers abort mid-stream. CPU-only
# hosts generate ~10-15 tok/s, so budget ~900000 for a full 4096-token completion.
INFERENCE_TIMEOUT_MS=900000
JWT_SECRET=dev-jwt-secret-change-me-in-production
INTERNAL_SERVICE_TOKEN=dev-internal-service-token
CORS_ORIGIN=http://localhost:9001

# Web / Auth.js
NEXTAUTH_URL=http://localhost:9001
AUTH_SECRET=dev-auth-secret-change-me-in-production
GATEWAY_INTERNAL_URL=http://localhost:9000
NEXT_PUBLIC_APP_URL=http://localhost:9001

# Billing (leave empty to use mock adapters)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
BILLING_MODE=mock

# Inference engine (config.toml preferred; env overrides supported)
TOTAL_RAM_BUDGET_MB=24000
# Use an absolute path: the gateway and inference engine run from different
# working directories, so a relative value resolves to two different folders.
MODEL_WEIGHTS_DIR=./data/models

# Inference backend:
#   llama-server = prebuilt llama.cpp binaries, no C++ toolchain (default)
#   grpc         = Rust inference engine, requires MSVC/CMake to compile
INFERENCE_BACKEND=llama-server
# Defaults to vendor/llama.cpp; populate it with: pnpm llama:fetch
LLAMA_SERVER_BIN=
LLAMA_SERVER_PORT_BASE=9100
LLAMA_AUTO_LOAD=true
# Warm the platform default model into RAM on gateway boot (set false to skip).
LLAMA_WARM_DEFAULT=true
# Keep only the platform default resident on boot / default change (ejects e.g. BanglaLLM).
LLAMA_SINGLE_DEFAULT=true
# Reasoning models (LFM2.5, DeepSeek-R1, gpt-oss) burn the completion budget on a
# hidden thought block before answering. Keep reasoning off so tokens go to the
# answer; set to "on" or "auto" if you want thinking, and pair with a larger
# max_tokens. Format "none" keeps any thoughts in message.content.
LLAMA_REASONING=off
LLAMA_REASONING_FORMAT=none
DEFAULT_N_THREADS=8
USE_MMAP=true
MAX_CONCURRENT_PER_MODEL=2
ENABLE_CONTINUOUS_BATCHING=true
GRPC_PORT=9002

# Remote LLM providers (OpenRouter / Gemini / OpenAI-compatible)
# Encrypts API keys stored for remote HostedModels (falls back to JWT_SECRET).
PROVIDER_CREDENTIALS_MASTER_KEY=
# Optional env fallback when a remote model has no ProviderCredential row:
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:9001
OPENROUTER_APP_TITLE=ModelForge
# Google Gemini (OpenAI-compatible endpoint). Prefer storing the key via Admin → Models.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Multimodal voice bypass model (native generateContent, not OpenAI-compat chat).
GEMINI_VOICE_MODEL=gemini-2.5-flash
# GEMINI_VOICE_MAX_OUTPUT_TOKENS=8192
# GEMINI_VOICE_TIMEOUT_MS=600000
# Disable Qwen/OpenRouter thinking tokens (avoids 12–40 tok stub answers). Set 0 to keep reasoning.
REMOTE_LLM_DISABLE_REASONING=1
# REMOTE_LLM_API_KEY=
# REMOTE_LLM_BASE_URL=

# Hugging Face model browser (optional)
# Read-only token for private/gated repositories; never sent to the browser.
HF_TOKEN=
# Protect host bandwidth/disk when downloading GGUF weights.
HF_MAX_CONCURRENT_DOWNLOADS=2
HF_MAX_DOWNLOAD_GB=100

# Voice STT (Phase 1: batch upload -> transcript -> LLM analysis)
VOICE_ENABLED=false
# local = Whisper/HF Space + pyannote | gemini = single multimodal call (ASR+diarize[+analysis])
VOICE_PIPELINE=local
VOICE_UPLOAD_DIR=./data/audio
VOICE_MAX_UPLOAD_MB=50
VOICE_RETENTION_HOURS=24
VOICE_RATE_LIMIT_PER_HOUR=20
STT_PROVIDER=faster-whisper
# Leave empty or set to "auto" for Whisper language detection; set "bn" to prefer Bangla.
STT_LANGUAGE=
# Optional Whisper vocabulary bias (overridden by x-asr-initial-prompt from Anusandhan).
STT_INITIAL_PROMPT=
# Same interpreter used for: pip install -r requirements-voice.txt
# Windows: use forward slashes, e.g. C:/Users/.../Python311/python.exe
# (backslash paths break dotenv escaping). Avoid Store python3 if it differs.
STT_PYTHON_BIN=python3
STT_FASTER_WHISPER_SCRIPT=scripts/faster-whisper-transcribe.py
# Default if no admin runtime override exists (data/voice/runtime.json).
# Install / switch models from Admin → Infra (does not require editing .env).
STT_FASTER_WHISPER_MODEL=small
STT_FASTER_WHISPER_DEVICE=cpu
STT_FASTER_WHISPER_COMPUTE_TYPE=int8
STT_FASTER_WHISPER_BEAM_SIZE=5
STT_FASTER_WHISPER_BEST_OF=5
STT_FASTER_WHISPER_TEMPERATURE=0
STT_FASTER_WHISPER_NO_SPEECH_THRESHOLD=0.35
# NeMo Bangla ASR (Bhatiyali). Requires: pip install "nemo_toolkit[asr]" + ffmpeg on PATH.
# License: CC-BY-NC-4.0 — non-commercial unless you have rights.
STT_NEMO_SCRIPT=scripts/nemo-asr-transcribe.py
STT_NEMO_MODEL=kazalbrur/bangla-stt-conformer-120m-dialects
STT_NEMO_DEVICE=cpu
# Hugging Face Space ASR (remote Gradio). Activate from Admin → Infra → HF Space (BengaliAI).
# Requires HF_TOKEN above. Default Space: bengaliAI/regional_bengali-asr_tugstugi_whisper-medium
STT_HF_SPACE_ID=bengaliAI/regional_bengali-asr_tugstugi_whisper-medium
# Optional override (defaults to https://<space-id-slug>.hf.space)
# STT_HF_SPACE_URL=
STT_HF_SPACE_FN_INDEX=0
STT_HF_SPACE_TIMEOUT_MS=600000
# Speaker diarization
# Pipeline: diarize first → ASR each speaker turn → combine (DIARIZATION_MODE=per-turn).
# Backends:
#   local = pyannote.audio on this host (DIARIZATION_MODEL + HF_TOKEN)
#   cloud = pyannoteAI API Precision-2 (PYANNOTE_API_KEY) — recommended for accuracy
DIARIZATION_ENABLED=false
DIARIZATION_BACKEND=cloud
DIARIZATION_MODE=per-turn
DIARIZATION_PROVIDER=pyannote
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_CLOUD_MODEL=precision-2
DIARIZATION_DEVICE=cpu
DIARIZATION_SCRIPT=scripts/pyannote-diarize.py
# Two-party calls (Anusandhan): set min=2 so diarization does not collapse to one speaker.
DIARIZATION_MIN_SPEAKERS=2
DIARIZATION_MAX_SPEAKERS=2
DIARIZATION_TURN_PAD_MS=200
DIARIZATION_ASR_CONCURRENCY=2
# pyannoteAI cloud API key (https://dashboard.pyannote.ai) — used when DIARIZATION_BACKEND=cloud
PYANNOTE_API_KEY=

# Shared data plane for client apps (e.g. Anusandhan). Optional until graph/object storage is needed.
# Local Windows/Mac: Neo4j Desktop → Bolt bolt://localhost:7687 (match password below).
# Ubuntu server: apt install neo4j && systemctl enable --now neo4j (not Desktop).
# MinIO API port 9010 avoids clash with inference gRPC on 9002.
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=modelforge-audio
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=modelforge
# Metering: Whisper is ASR (audio seconds → billable units). Neo4j ops use separate unit rates.
STT_BILLABLE_UNITS_PER_SEC=25
NEO4J_READ_BILLABLE_UNITS=1
NEO4J_WRITE_BILLABLE_UNITS=5

# Modern platform (local-first defaults)
# Directory for Ed25519 usage-receipt signing keys (created on first use)
MODELFORGE_SIGNING_DIR=./data/signing
# Redact emails/phones/cards from prompts before inference
MODELFORGE_PII_REDACT=true
# Comma-separated model IDs that LRU eviction must never unload
MODELFORGE_PROTECTED_MODELS=

# Optional real-model smoke tests
TEST_GGUF_PATH=
MODELFORGE_API_KEY=
MODELFORGE_BASE_URL=http://localhost:9000/v1
MODELFORGE_TEST_MODEL=zms-coder-7b
BENCH_CONCURRENCY=2
BENCH_REQUESTS=6
